# Pin a released tag for reproducible deployments, e.g. willi28/open-clocktower:0.4
OPEN_CLOCKTOWER_IMAGE=willi28/open-clocktower:latest
APP_DOMAIN=botc.example.com
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=le

POSTGRES_DB=open_clocktower
POSTGRES_USER=open_clocktower
POSTGRES_PASSWORD=change-me-to-a-long-random-password

FORCE_HTTPS=true
# Which peers may set X-Forwarded-For/-Proto. Must cover the reverse proxy and
# nothing else - "*" would let any client spoof its IP past the rate limits.
FORWARDED_ALLOW_IPS=172.16.0.0/12
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
ROOM_IDLE_TTL_SECONDS=3600
ROOM_CLEANUP_INTERVAL_SECONDS=300
