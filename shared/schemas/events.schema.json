{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Clocktower WebSocket Event",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "connected",
        "player.joined",
        "player.seated",
        "phase.changed",
        "nomination.started",
        "vote.started",
        "vote.cast",
        "game.updated",
        "room.settings_updated"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
