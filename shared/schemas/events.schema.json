{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Clocktower WebSocket Event",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "connected",
        "game.updated",
        "chat.message",
        "chat.private.notice",
        "hand.state",
        "timer.state",
        "vote_count.state",
        "bell.ring",
        "nomination.executed",
        "voice.state",
        "voice.call.request",
        "voice.call.accept",
        "voice.call.reject",
        "voice.signal",
        "room.kicked",
        "room.deleted"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
