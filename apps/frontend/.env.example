# Frontend build-time configuration (Vite). Copy to .env and adjust.
# All voice settings are documented in docs/voice-audio.md.

# Backend origin used by the dev server proxy.
#VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Opus target bitrate for outgoing speech in bit/s (16000-256000).
#VITE_VOICE_MAX_BITRATE=64000

# Opus in-band forward error correction (packet-loss concealment).
#VITE_VOICE_FEC=true

# Opus discontinuous transmission. Saves bandwidth, hurts quality.
#VITE_VOICE_DTX=false

# Noise suppression engine when a player's sound filters are on:
# rnnoise (WASM model, falls back to native automatically) | native | off
#VITE_VOICE_NOISE_SUPPRESSION=rnnoise
