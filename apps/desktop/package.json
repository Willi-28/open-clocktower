{
  "name": "open-clocktower-desktop",
  "private": true,
  "version": "0.8.2",
  "description": "Steam desktop shell for connecting to self-hosted Open Clocktower servers.",
  "author": "Open Clocktower",
  "license": "MIT",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend run build",
    "build:frontend:release": "npm --prefix ../frontend run build -- --mode release",
    "verify:frontend:release": "node scripts/verify-release-frontend.mjs",
    "prestart": "npm run build:frontend",
    "start": "electron .",
    "test": "node test/gateway.test.mjs",
    "predist": "npm run build:frontend:release && npm run verify:frontend:release",
    "dist": "electron-builder",
    "predist:dir": "npm run build:frontend:release && npm run verify:frontend:release",
    "dist:dir": "electron-builder --dir --config.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "electron": "^43.5.1",
    "electron-builder": "^26.15.3"
  }
}
