{
  "name": "open-clocktower-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Steam desktop shell for connecting to self-hosted Open Clocktower servers.",
  "author": "Open Clocktower",
  "license": "MIT",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "build:frontend": "npm --prefix ../frontend run build",
    "prestart": "npm run build:frontend",
    "start": "electron .",
    "test": "node test/gateway.test.mjs",
    "predist": "npm run build:frontend",
    "dist": "electron-builder",
    "predist:dir": "npm run build:frontend",
    "dist:dir": "electron-builder --dir --config.win.signAndEditExecutable=false",
    "steam:build": "node scripts/steam-build.mjs",
    "steam:build:test": "node scripts/steam-build.mjs --dev-appid"
  },
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
