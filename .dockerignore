# The image is built from apps/frontend + apps/backend only. Everything else is
# kept out of the build context so no local state, build output, or secret ever
# reaches the Docker daemon or an image layer.

.git
.github
.codex
.agents
.claude

# Python
.venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Node / build output. The bare names only match the context root, so the
# recursive form is required for the per-app folders.
**/node_modules
**/dist
**/.vite
**/.npm-cache
**/*.tsbuildinfo
# The frontend build is copied in from the frontend stage, never from context.
apps/backend/app/static

# Character packs are supplied locally and are not baked into public images.
apps/frontend/src/packs/*.zip
apps/frontend/src/packs/**/*.zip

# The Electron/Steam client is not part of the server image, and its release
# folder is hundreds of megabytes.
apps/desktop
steamcmd
steamworks_sdk
release-commands.local.txt

# Local runtime state and secrets
data
**/*.log
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
.env
.env.*
!.env.example

# Local editor and operating-system metadata
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Docs, tooling, and compose files are not needed to build or run the image
docs
scripts
shared
README.md
SECURITY.md
LICENSE
docker-compose*.yml

# Local security audit output - never belongs in a published image.
SECURITY-CWE-COVERAGE.txt
